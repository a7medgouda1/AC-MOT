\@writefile{lot}{\contentsline {table}{\numberline {2}{\ignorespaces Tracking metrics used in this paper. GT is the number of ground-truth boxes; FP, FN, and IDS are the false positives, missed objects (false negatives), and identity switches, summed over all frames. For IDF1, each ground-truth track is first matched to at most one output track, and IDTP, IDFP, and IDFN are the true-positive, false-positive, and false-negative boxes under this matching. For HOTA, at a localization threshold $\alpha $, $\mathrm  {TP}_\alpha $, $\mathrm  {FN}_\alpha $, and $\mathrm  {FP}_\alpha $ are the matched, missed, and unmatched boxes, and $\mathcal  {A}(c)$ is the association accuracy of a matched pair $c$. HOTA, MOTA, and IDF1 are given in percent.}}{4}{table.14}\protected@file@percent }
\newlabel{tab:metrics}{{2}{4}{Tracking metrics used in this paper. GT is the number of ground-truth boxes; FP, FN, and IDS are the false positives, missed objects (false negatives), and identity switches, summed over all frames. For IDF1, each ground-truth track is first matched to at most one output track, and IDTP, IDFP, and IDFN are the true-positive, false-positive, and false-negative boxes under this matching. For HOTA, at a localization threshold $\alpha $, $\mathrm {TP}_\alpha $, $\mathrm {FN}_\alpha $, and $\mathrm {FP}_\alpha $ are the matched, missed, and unmatched boxes, and $\mathcal {A}(c)$ is the association accuracy of a matched pair $c$. HOTA, MOTA, and IDF1 are given in percent}{table.14}{}}
