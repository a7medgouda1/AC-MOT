\newlabel{tab:baselines}{{13}{21}{HOTA and identity switches of \scl {} and of two simple adaptive-threshold baselines on KITTI tracking training (official HOTA, car and pedestrian averaged). Host: the tracker alone, without any layer. Adaptive $t_1$, $t_2$: the tracker's matching and birth thresholds are set in every frame to the first or second Otsu split of the logits of the last 10 frames, and the scores are passed unchanged. $\Delta $: \scl {} minus the adaptive $t_2$ baseline, with 95\% paired-bootstrap interval; bold intervals exclude zero. IDS: identity switches, a count (lower is better); a host with 0 HOTA follows no object, so it also has 0 IDS}{table.92}{}}
\@writefile{lot}{\contentsline {table}{\numberline {14}{\ignorespaces HOTA of ACT \cite  {act2026adaptive} and of SCL{} on the same detections, and the differences SCL{} minus ACT in HOTA, IDF1, and identity switches (IDS, a count; lower is better), with 95\% paired-bootstrap interval below each value; bold intervals exclude zero. ACT: published parameters, no tuning. KITTI: official HOTA, car and pedestrian averaged; MOT17: val-half, ACT's own setting; UAVDT: test split, one vehicle class, ignored regions removed (Sect.~\ref {sec:metrics}).}}{21}{table.94}\protected@file@percent }
\newlabel{tab:act}{{14}{21}{HOTA of ACT \cite {act2026adaptive} and of \scl {} on the same detections, and the differences \scl {} minus ACT in HOTA, IDF1, and identity switches (IDS, a count; lower is better), with 95\% paired-bootstrap interval below each value; bold intervals exclude zero. ACT: published parameters, no tuning. KITTI: official HOTA, car and pedestrian averaged; MOT17: val-half, ACT's own setting; UAVDT: test split, one vehicle class, ignored regions removed (Sect.~\ref {sec:metrics})}{table.94}{}}
\@writefile{lot}{\contentsline {table}{\numberline {15}{\ignorespaces Baseline comparison on the predeclared external systems (MOT17 val-half, authors' released detections), each evaluated once with the frozen SCL{}. Paper: number reported by the authors (for PD-SORT, their released output). Host: the tracker alone, without SCL{} (our run of the published tracker). Reproduction class against the authors' number (EXACT: $|\Delta \mathrm  {HOTA}|\le 0.2$; CLOSE: $\le 1.0$ with a documented, untuned cause). $\Delta $: host with SCL{} minus host, with 95\% paired-bootstrap interval; bold intervals exclude zero. IDS: identity switches, a count (lower is better); --: not reported.}}{21}{table.97}\protected@file@percent }
